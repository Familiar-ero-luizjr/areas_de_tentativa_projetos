{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.advogadoja.local/tela-v10.schema.json",
  "title": "AdvogadoJá — Tela Canônica V10",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "identidade",
    "classificacao",
    "estrutura",
    "estados",
    "interacoes",
    "navegacao",
    "dados",
    "mocks"
  ],
  "$defs": {
    "condition": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "estadoRef",
            "igual"
          ],
          "properties": {
            "estadoRef": {
              "type": "string",
              "minLength": 1
            },
            "igual": {
              "type": [
                "string",
                "boolean",
                "number",
                "null"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "todos"
          ],
          "properties": {
            "todos": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/condition"
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "qualquer"
          ],
          "properties": {
            "qualquer": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/condition"
              }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "target": {
      "type": "object",
      "required": [
        "tipo"
      ],
      "properties": {
        "tipo": {
          "enum": [
            "elemento",
            "instancia"
          ]
        },
        "ref": {
          "type": "string"
        },
        "instanciaRef": {
          "type": "string"
        },
        "classes": {
          "type": "object",
          "additionalProperties": {
            "type": "boolean"
          }
        },
        "atributos": {
          "type": "object"
        },
        "texto": {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        "quando": {
          "$ref": "#/$defs/condition"
        }
      },
      "additionalProperties": false
    },
    "option": {
      "type": "object",
      "required": [
        "id",
        "alvos"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "alvos": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/target"
          }
        }
      },
      "additionalProperties": false
    },
    "dimension": {
      "type": "object",
      "required": [
        "id",
        "inicial",
        "opcoes"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "inicial": {
          "type": "string"
        },
        "origemValor": {
          "type": "string"
        },
        "opcoes": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/option"
          }
        }
      },
      "additionalProperties": false
    },
    "origin": {
      "type": "object",
      "required": [
        "instanciaRef",
        "eventoRef"
      ],
      "properties": {
        "instanciaRef": {
          "type": "string"
        },
        "eventoRef": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "cssRule": {
      "type": "object",
      "required": [
        "id",
        "ordem",
        "css"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "ordem": {
          "type": "number"
        },
        "css": {
          "type": "string"
        },
        "aplicaQuando": {
          "$ref": "#/$defs/condition"
        }
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "identidade": {
      "type": "object",
      "required": [
        "id",
        "tipo",
        "namespace",
        "nome",
        "nomeExibicao"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "tipo": {
          "const": "tela"
        },
        "namespace": {
          "type": "string"
        },
        "nome": {
          "type": "string"
        },
        "nomeExibicao": {
          "type": "string"
        },
        "descricao": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "classificacao": {
      "type": "object",
      "required": [
        "localizacao",
        "jornadaRefs",
        "subjornadaRefs"
      ],
      "properties": {
        "localizacao": {
          "type": "object",
          "required": [
            "caminho"
          ],
          "properties": {
            "caminho": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "perfilRef": {
          "type": "string"
        },
        "jornadaRefs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "subjornadaRefs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "estrutura": {
      "type": "object",
      "required": [
        "html",
        "css"
      ],
      "additionalProperties": false,
      "properties": {
        "html": {
          "type": "object",
          "required": [
            "raizRef",
            "composicao"
          ],
          "additionalProperties": false,
          "properties": {
            "raizRef": {
              "type": "string"
            },
            "composicao": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "type": "object",
                "required": [
                  "id",
                  "componenteRef",
                  "paiRef",
                  "alvoRef",
                  "ordem",
                  "props"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "componenteRef": {
                    "type": "string"
                  },
                  "paiRef": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "alvoRef": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "ordem": {
                    "type": "number"
                  },
                  "props": {
                    "type": "object"
                  },
                  "estados": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    }
                  },
                  "visivelQuando": {
                    "$ref": "#/$defs/condition"
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "css": {
          "type": "object",
          "required": [
            "tokens",
            "regras"
          ],
          "additionalProperties": false,
          "properties": {
            "tokens": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "regras": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/cssRule"
              }
            },
            "folhasRefs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "estados": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/dimension"
      }
    },
    "interacoes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "origem",
          "efeito"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "origem": {
            "$ref": "#/$defs/origin"
          },
          "efeito": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    },
    "navegacao": {
      "type": "object",
      "required": [
        "rotas"
      ],
      "additionalProperties": false,
      "properties": {
        "rotas": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "origem",
              "destinoRef"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "origem": {
                "$ref": "#/$defs/origin"
              },
              "destinoRef": {
                "type": "string"
              },
              "status": {
                "type": "string"
              },
              "quando": {
                "$ref": "#/$defs/condition"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    "dados": {
      "type": "object",
      "required": [
        "fontes",
        "operacoes"
      ],
      "additionalProperties": false,
      "properties": {
        "fontes": {
          "type": "array"
        },
        "operacoes": {
          "type": "array"
        }
      }
    },
    "mocks": {
      "type": "object",
      "required": [
        "cenarios"
      ],
      "additionalProperties": false,
      "properties": {
        "cenarios": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "nome",
              "valores"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "nome": {
                "type": "string"
              },
              "tipo": {
                "type": "string"
              },
              "valores": {
                "type": "object"
              }
            },
            "additionalProperties": false
          }
        }
      }
    }
  }
}