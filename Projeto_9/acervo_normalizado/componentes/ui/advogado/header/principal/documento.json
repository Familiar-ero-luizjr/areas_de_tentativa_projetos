        {
          "id": "ui_advogado_header_principal.r0001",
          "ordem": 10,
          "css": ".app-header{min-height:64px;display:grid;grid-template-columns:42px minmax(0,1fr) 42px;gap:10px;align-items:center;padding:8px 14px;background:var(--primary);color:#fff;box-shadow:0 4px 14px #10233f2e;position:sticky;top:0;z-index:10}"
        },
        {
          "id": "ui_advogado_header_principal.r0002",
          "ordem": 20,
          "css": ".app-menu-button,.app-notifications{width:40px;height:40px;display:grid;place-content:center;border:0;border-radius:10px;background:transparent;color:#fff}"
        },
        {
          "id": "ui_advogado_header_principal.r0003",
          "ordem": 30,
          "css": ".app-menu-button{gap:4px}"
        },
        {
          "id": "ui_advogado_header_principal.r0004",
          "ordem": 40,
          "css": ".app-menu-button span{width:20px;height:2px;border-radius:8px;background:#fff}"
        },
        {
          "id": "ui_advogado_header_principal.r0005",
          "ordem": 50,
          "css": ".app-brand{display:flex;align-items:center;gap:9px;min-width:0}"
        },
        {
          "id": "ui_advogado_header_principal.r0006",
          "ordem": 60,
          "css": ".brand-symbol{width:28px;height:28px;flex:none}"
        },
        {
          "id": "ui_advogado_header_principal.r0007",
          "ordem": 70,
          "css": ".app-brand-copy strong,.app-brand-copy small{display:block}"
        },
        {
          "id": "ui_advogado_header_principal.r0008",
          "ordem": 80,
          "css": ".app-brand-copy strong{font-size:16px;letter-spacing:-.02em;white-space:nowrap}"
        },
        {
          "id": "ui_advogado_header_principal.r0009",
          "ordem": 90,
          "css": ".app-brand-copy small{font-size:9px;font-weight:800;letter-spacing:.08em;opacity:.72;margin-top:1px;text-transform:uppercase}"
        },
        {
          "id": "ui_advogado_header_principal.r0010",
          "ordem": 100,
          "css": ".app-notifications{position:relative;justify-self:end}"
        },
        {
          "id": "ui_advogado_header_principal.r0011",
          "ordem": 110,
          "css": ".app-notifications svg{width:22px;height:22px;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}"
