          "ordem": 100,
          "css": "\n:root{--primary:#10233f;--primary-soft:#173c6b;--gold:#b88932;--page:#eef2f6;--line:#dbe3ee;--muted:#667085;--ink:#172033}\n*{box-sizing:border-box}body{margin:0;min-height:100dvh;background:var(--page);color:var(--ink);font:14px/1.45 'Plus Jakarta Sans',Inter,'Segoe UI',Arial,sans-serif}\n.mobile{max-width:430px;min-height:100dvh;margin:auto;background:#fff;box-shadow:0 9px 45px #10233f0f;display:flex;flex-direction:column}\nheader{background:var(--primary);color:white;padding:18px 22px;display:flex;align-items:center;gap:12px;min-height:79px}\n.logo{width:38px;height:38px;display:grid;place-items:center;background:#f6ebd9;color:var(--primary);border-radius:11px;font-size:17px;font-weight:900;letter-spacing:-2px}\nheader b{font-size:16px;letter-spacing:.1px}header small{display:block;color:#b9cbe0;font-size:10px;margin-top:2px}\nmain{flex:1;padding:40px 26px 25px}.eyebrow{font-size:11px;text-transform:uppercase;color:#986e26;letter-spacing:1.6px;font-weight:800;margin-bottom:12px}.symbol{width:58px;height:58px;display:grid;place-items:center;background:#f3e8d7;border-radius:18px;color:var(--primary);margin-bottom:26px}\n.symbol svg{width:31px;height:31px}h1{font-size:28px;letter-spacing:-.8px;line-height:1.13;color:var(--primary);margin:0 0 12px}p{font-size:13px;line-height:1.7;color:var(--muted);margin:0 0 26px}.field{margin:18px 0}.field label{display:block;font-size:12px;font-weight:800;color:#354663;margin-bottom:8px}.field input{width:100%;border:1px solid #c9d6e6;border-radius:12px;padding:14px 13px;font:inherit;color:var(--ink);outline:none;background:#fff}.field input:focus{border-color:#214b78;box-shadow:0 0 0 3px #214b7816}.field input::placeholder{color:#9ba9b9}\n.hint{font-size:11px;color:#75859a;margin:7px 0 0}.btn{display:flex;align-items:center;justify-content:center;width:100%;padding:14px;border-radius:12px;border:1px solid transparent;font:800 13px/1.4 'Plus Jakarta Sans',Inter,'Segoe UI',Arial,sans-serif;cursor:pointer;margin-top:23px}.btn.primary{background:var(--primary);color:#fff}.btn.secondary{background:#f4f7fb;border-color:#dbe3ee;color:var(--primary)}.btn:hover{filter:brightness(1.08)}.info{font-size:11px;color:#526781;background:#f2f6fb;border:1px solid #dce7f3;border-radius:12px;padding:13px;margin-top:18px;line-height:1.6}.message{display:none;margin:16px 0 0;padding:13px;border-radius:10px;background:#e7f5eb;color:#186441;border:1px solid #bfdfc8;font-size:12px}.message.show{display:block}.error{background:#fff0ee;color:#a92e2e;border-color:#ffd4cc}footer{margin-top:auto;background:#f8fafc;border-top:1px solid var(--line);padding:15px 24px;text-align:center;font-size:10px;color:#7b8999}footer strong{color:#354663}\n@media(max-width:430px){main{padding-top:35px}.mobile{box-shadow:none}}\n"
