  "estilos": {
    "css": "\n.admin-ui{--admin:#7c2d12;--admin2:#9a3412;--admin-soft:#fff7ed;--admin-line:#fed7aa}\n.admin-ui .admin-nav{display:flex;gap:6px;flex-wrap:wrap;margin:0 0 16px}\n.admin-ui .admin-nav span{padding:7px 9px;border:1px solid var(--line);border-radius:999px;background:#fff;color:var(--muted);font-size:10px;font-weight:800}\n.admin-ui .admin-nav span.active{border-color:#fdba74;background:#fff7ed;color:#9a3412}\n.admin-ui .admin-kicker{margin:0 0 7px;color:#9a3412;font-size:10px;font-weight:900;letter-spacing:.08em;text-transform:uppercase}\n.admin-ui .admin-title{margin:0;color:var(--primary);font-size:clamp(24px,5vw,34px);line-height:1.12}\n.admin-ui .admin-copy{margin:9px 0 18px;color:var(--muted);font-size:14px;line-height:1.55}\n.admin-ui .admin-banner{margin:0 0 14px;padding:12px 14px;border:1px solid #fed7aa;border-radius:13px;background:#fff7ed;color:#7c2d12;font-size:12px;line-height:1.5}\n.admin-ui .admin-banner.info{border-color:#bfdbfe;background:#eff6ff;color:#1e3a8a}\n.admin-ui .admin-banner.pending{border-style:dashed;border-color:#fbbf24;background:#fffbeb;color:#854d0e}\n.admin-ui .metric-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin-bottom:14px}\n.admin-ui .metric{padding:15px;border:1px solid var(--line);border-radius:14px;background:#fff}\n.admin-ui .metric b{display:block;color:var(--primary);font-size:23px}\n.admin-ui .metric span{display:block;margin-top:3px;color:var(--muted);font-size:10px}\n.admin-ui .queue-card{display:grid;grid-template-columns:1fr auto;gap:12px;align-items:center;margin-bottom:10px;padding:14px;border:1px solid var(--line);border-radius:14px;background:#fff}\n.admin-ui .queue-card strong,.admin-ui .queue-card small{display:block}\n.admin-ui .queue-card strong{color:var(--primary);font-size:13px}.admin-ui .queue-card small{margin-top:4px;color:var(--muted);font-size:10px;line-height:1.4}\n.admin-ui .count{min-width:34px;padding:6px 8px;border-radius:999px;background:#fff7ed;color:#9a3412;font-size:10px;font-weight:900;text-align:center}\n.admin-ui .count.neutral{background:#f1f5f9;color:#475569}\n.admin-ui .admin-table{overflow:hidden;border:1px solid var(--line);border-radius:14px;background:#fff}\n.admin-ui .tr{display:grid;grid-template-columns:1.2fr .9fr .8fr auto;gap:10px;align-items:center;padding:11px 13px;border-bottom:1px solid #edf0f4;font-size:11px}\n.admin-ui .tr:last-child{border-bottom:0}.admin-ui .tr.head{background:#f8fafc;color:#64748b;font-size:9px;font-weight:900;text-transform:uppercase}.admin-ui .tr strong{color:var(--primary)}\n.admin-ui .status-pill{display:inline-flex;width:max-content;padding:5px 7px;border-radius:999px;background:#ecfdf5;color:#047857;font-size:9px;font-weight:900}.admin-ui .status-pill.wait{background:#fffbeb;color:#a16207}.admin-ui .status-pill.block{background:#fef2f2;color:#b91c1c}\n.admin-ui .detail-grid{display:grid;gap:10px}.admin-ui .detail-row{display:grid;grid-template-columns:minmax(120px,.7fr) 1.3fr;gap:12px;padding:10px 0;border-bottom:1px solid #edf0f4;font-size:12px}.admin-ui .detail-row:last-child{border-bottom:0}.admin-ui .detail-row span{color:var(--muted)}.admin-ui .detail-row strong{color:var(--primary)}\n.admin-ui .permission-grid{display:grid;gap:8px}.admin-ui .permission-row{display:flex;gap:12px;align-items:center;justify-content:space-between;padding:11px 12px;border:1px solid var(--line);border-radius:12px;background:#fff}.admin-ui .permission-row div strong,.admin-ui .permission-row div small{display:block}.admin-ui .permission-row div small{margin-top:3px;color:var(--muted);font-size:10px}\n.admin-ui .toggle-demo{width:38px;height:22px;border:0;border-radius:999px;background:#cbd5e1;position:relative}.admin-ui .toggle-demo.on{background:#173c6b}.admin-ui .toggle-demo::after{content:\"\";position:absolute;top:3px;left:3px;width:16px;height:16px;border-radius:50%;background:#fff}.admin-ui .toggle-demo.on::after{left:19px}\n.admin-ui .profile-options{display:grid;gap:10px}.admin-ui .profile-option{padding:14px;border:1px solid var(--line);border-radius:14px;background:#fff;text-align:left}.admin-ui .profile-option.admin{border-color:#fdba74;background:#fffaf5}.admin-ui .profile-option strong,.admin-ui .profile-option small{display:block}.admin-ui .profile-option strong{color:var(--primary)}.admin-ui .profile-option small{margin-top:4px;color:var(--muted);font-size:10px}\n.admin-ui .audit-line{padding:11px 0;border-bottom:1px solid #edf0f4}.admin-ui .audit-line:last-child{border-bottom:0}.admin-ui .audit-line strong{display:block;color:var(--primary);font-size:11px}.admin-ui .audit-line small{display:block;margin-top:3px;color:var(--muted);font-size:10px;line-height:1.4}\n@media(min-width:800px){.admin-ui .metric-grid{grid-template-columns:repeat(4,minmax(0,1fr))}.admin-ui .detail-grid.two{grid-template-columns:1fr 1fr}}\n@media(max-width:650px){.admin-ui .tr{grid-template-columns:1fr auto}.admin-ui .tr>*:nth-child(2),.admin-ui .tr>*:nth-child(3){display:none}.admin-ui .tr.head{display:none}}\n",
    "id": "css_cmp.admin.dashboard.perfil_administrador.v01"
  },
