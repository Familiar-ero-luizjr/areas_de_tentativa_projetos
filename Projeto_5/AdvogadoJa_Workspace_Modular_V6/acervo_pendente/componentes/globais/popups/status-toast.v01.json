{
  "schema": "advogadoja.componente.reutilizavel.v2-proposta",
  "identidade": {
    "id": "popup.status-toast.v01",
    "nome": "Toast de alteração de status",
    "tipo": "componente",
    "versao": "1.0.0"
  },
  "estrutura": {
    "formato": "arvore_elementos",
    "arvore": [
      {
        "id": "status-toast::0",
        "tag": "div",
        "atributos": {
          "class": "status-toast",
          "data-toast-root": "",
          "role": "status",
          "aria-live": "polite"
        },
        "filhos": [
          {
            "id": "status-toast::0.0",
            "tag": "span",
            "atributos": {
              "data-toast-text": ""
            }
          }
        ]
      }
    ],
    "id": "html_popup.status-toast.v01"
  },
  "estilos": {
    "css": ".status-toast{position:fixed;left:50%;bottom:92px;transform:translate(-50%,18px);opacity:0;pointer-events:none;padding:10px 14px;border-radius:999px;background:#10233f;color:#fff;font-size:13px;box-shadow:0 10px 30px #0003;transition:.2s ease}.status-toast.show{opacity:1;transform:translate(-50%,0)}@media(min-width:900px){.status-toast{bottom:28px}}",
    "id": "css_popup.status-toast.v01"
  },
  "interface": {
    "propriedadesAceitas": [],
    "eventosEmitidos": [],
    "regraBinding": "props calculadas pelo motor a partir de dadosRef/textosRef/instancia da tela; componente nao consulta a tela ou outros arquivos diretamente"
  },
  "classificacao": {
    "escopo": "global",
    "jornadas": [
      "*"
    ],
    "localizacaoArvore": {
      "secao": "Componentes",
      "segmentos": [
        "globais",
        "popups"
      ],
      "chave": "status-toast.v01"
    }
  }
}
