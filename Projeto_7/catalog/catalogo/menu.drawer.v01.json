{
  "schema": "advogadoja.componente.reutilizavel.v1-proposta",
  "identidade": {
    "id": "cmp_advogado_home_advogado_main_oab_validation_panel",
    "nome": "Painel de validação OAB",
    "tipo": "componente",
    "escopo": "local",
    "categoria": "main"
  },
  "estrutura": {
    "formato": "arvore_elementos",
    "arvore": [
      {
        "id": "oab-validation-panel::root",
        "tag": "section",
        "atributos": {
          "class": "oab-gate-card",
          "aria-labelledby": "oab-gate-title"
        },
        "filhos": [
          {
            "id": "oab-validation-panel::eyebrow",
            "tag": "span",
            "atributos": {
              "class": "oab-gate-eyebrow"
            },
            "filhos": [
              {
                "ref": "props.dados.rotulo"
              }
            ]
          },
          {
            "id": "oab-validation-panel::title",
            "tag": "h2",
            "atributos": {
              "id": "oab-gate-title"
            },
            "filhos": [
              {
                "ref": "props.dados.titulo"
              }
            ]
          },
          {
            "id": "oab-validation-panel::description",
            "tag": "p",
            "filhos": [
              {
                "ref": "props.dados.descricao"
              }
            ]
          },
          {
            "id": "oab-validation-panel::status",
            "tag": "p",
            "atributos": {
              "class": "oab-gate-status"
            },
            "filhos": [
              {
                "ref": "props.dados.statusTexto"
              }
            ]
          },
          {
            "id": "oab-validation-panel::cta",
            "tag": "button",
            "atributos": {
              "type": "button",
              "class": "oab-gate-button",
              "data-action": "oab.validar"
            },
            "filhos": [
              {
                "ref": "props.dados.textoBotao"
              }
            ]
          }
        ]
      }
    ]
  },
  "estilos": {
    "css": ".oab-gate-card{margin:16px 0;padding:24px;border:1px solid #d9cba9;border-radius:16px;background:#fffaf0;color:var(--text,#242424)}.oab-gate-eyebrow{font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:#936b22}.oab-gate-card h2{margin:10px 0;font-size:22px}.oab-gate-card p{line-height:1.5}.oab-gate-status{font-size:13px;color:#745526}.oab-gate-button{margin-top:12px;border:0;border-radius:10px;padding:12px 18px;background:var(--primary,#2b4d85);color:#fff;font-weight:650;cursor:pointer}"
  },
  "interface": {
    "propriedadesAceitas": [
      "rotulo",
      "titulo",
      "descricao",
      "statusTexto",
      "textoBotao"
    ],
    "eventosEmitidos": [
      "solicitarValidacaoOab"
    ],
    "regraBinding": "props calculadas pelo motor a partir de dadosRef/textosRef/instancia da tela; componente nao consulta a tela ou outros arquivos diretamente"
  },
  "dadosExemplo": {
    "rotulo": "VALIDAÇÃO PROFISSIONAL",
    "titulo": "Valide sua OAB para liberar sua Home",
    "descricao": "Seu cadastro foi recebido. Para acessar solicitações e disponibilizar atendimentos, conclua ou acompanhe a verificação da OAB.",
    "statusTexto": "O acesso completo depende da confirmação da OAB.",
    "textoBotao": "Verificar minha OAB"
  },
  "origemHistorica": {
    "sourcePath": "telas/advogado/home_advogado/main/oab-validation-panel",
    "descricao": "Painel da montagem pendente extraído do linear_v3."
  }
}
