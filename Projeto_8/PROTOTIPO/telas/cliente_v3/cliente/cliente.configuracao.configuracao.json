  "status": "original",
  "html": "<div class=\"screen-runtime\"><div class=\"prototype-screen operational client-legacy\"><div class=\"app-header\"><div></div><div class=\"app-brand\"><strong>AdvogadoJá</strong></div><div class=\"app-role\">Cliente</div></div><div class=\"app-titlebar\">Cliente · Configurações</div><div class=\"screen-layout\"><div class=\"screen-slot screen-slot--main\"><main class=\"op-shell client-legacy__content\"><div class=\"op-card\"><h2>Configurações</h2><p>Preferências e opções de apoio da sua conta</p></div><div class=\"op-grid settings-grid\"><button class=\"op-action\" type=\"button\" data-goto=\"cliente.onboarding.preferencias_contato\"><span><strong>Preferências de contato</strong><small>Defina como prefere receber contatos e comunicações</small></span><span aria-hidden=\"true\">›</span></button><button class=\"op-action\" type=\"button\" data-goto=\"cliente.configuracao.termos_privacidade\"><span><strong>Termos e privacidade</strong><small>Termos de uso política de privacidade e consentimentos da conta</small></span><span aria-hidden=\"true\">›</span></button><button class=\"op-action\" type=\"button\" data-goto=\"cliente.configuracao.suporte\"><span><strong>Suporte</strong><small>Central de ajuda contato com suporte e chamados</small></span><span aria-hidden=\"true\">›</span></button></div><div class=\"op-toast\" role=\"status\" aria-live=\"polite\"></div></main></div></div></div></div>",
  "css": ".settings-grid{display:grid;gap:10px}.settings-grid .op-action{width:100%;display:flex;align-items:center;justify-content:space-between;gap:16px;text-align:left}.settings-grid .op-action>span:first-child{display:grid;gap:4px}.settings-grid .op-action strong,.settings-grid .op-action small{display:block}.settings-grid .op-action small{color:var(--muted);font-size:12px;line-height:1.4}\n"
}
