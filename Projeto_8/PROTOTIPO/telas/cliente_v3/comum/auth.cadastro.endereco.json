{
  "id": "auth.cadastro.endereco",
  "titulo": "Cadastro · Dados pessoais · Endereço",
  "origem": "catalogo/telas/comum/auth/endereco.json",
  "status": "original",
  "html": "<div class=\"screen-runtime\"><div class=\"prototype-screen\"><div class=\"screen-slot screen-slot--header\" data-slot=\"header\"><header class=\"topbar\"><img src=\"data:image/svg+xml;base64,\" alt=\"\"><span>AdvogadoJá</span></header></div><div class=\"screen-layout\"><div class=\"screen-slot screen-slot--main\" data-slot=\"main\"><div class=\"registration__shell\"><div class=\"registration__intro\"><p class=\"eyebrow\">Dados pessoais</p><h1>Endereço</h1><p>Endereço residencial associado à conta. Localização precisa continua sendo tratada separadamente.</p></div><div class=\"progress\" aria-label=\"Etapa 4 de 7\"><span></span></div><form class=\"form-card\" data-registration-form=\"\"><div class=\"field\"><input id=\"reg-zip\" name=\"zipCode\" type=\"text\" placeholder=\" \" autocomplete=\"postal-code\" data-reg-field=\"zipCode\" required><label for=\"reg-zip\">CEP</label></div><div class=\"field\"><input id=\"reg-address\" name=\"address\" type=\"text\" placeholder=\" \" autocomplete=\"address-line1\" data-reg-field=\"address\" required><label for=\"reg-address\">Logradouro</label></div><div class=\"field-grid\"><div class=\"field\"><input id=\"reg-number\" name=\"addressNumber\" type=\"text\" placeholder=\" \" autocomplete=\"address-line2\" data-reg-field=\"addressNumber\" required><label for=\"reg-number\">Número</label></div><div class=\"field\"><input id=\"reg-complement\" name=\"complement\" type=\"text\" placeholder=\" \" data-reg-field=\"complement\"><label for=\"reg-complement\">Complemento</label></div></div><div class=\"field-grid\"><div class=\"field\"><input id=\"reg-neighborhood\" name=\"neighborhood\" type=\"text\" placeholder=\" \" data-reg-field=\"neighborhood\" required><label for=\"reg-neighborhood\">Bairro</label></div><div class=\"field\"><input id=\"reg-district\" name=\"district\" type=\"text\" placeholder=\" \" data-reg-field=\"district\"><label for=\"reg-district\">Distrito</label></div></div><div class=\"field\"><input id=\"reg-city\" name=\"city\" type=\"text\" placeholder=\" \" autocomplete=\"address-level2\" data-reg-field=\"city\" required><label for=\"reg-city\">Cidade</label></div><div class=\"field-grid\"><div class=\"select-field\"><label for=\"reg-uf\">UF</label><select id=\"reg-uf\" name=\"uf\" autocomplete=\"address-level1\" data-reg-field=\"uf\" required><option value=\"\">Selecionar</option><option>AC</option><option>AL</option><option>AP</option><option>AM</option><option>BA</option><option>CE</option><option>DF</option><option>ES</option><option>GO</option><option>MA</option><option>MT</option><option>MS</option><option>MG</option><option>PA</option><option>PB</option><option>PR</option><option>PE</option><option>PI</option><option>RJ</option><option>RN</option><option>RS</option><option>RO</option><option>RR</option><option>SC</option><option>SP</option><option>SE</option><option>TO</option></select></div><div class=\"select-field\"><label for=\"reg-country\">País</label><select id=\"reg-country\" name=\"country\" data-reg-field=\"country\"><option value=\"BR\">Brasil</option></select></div></div><div class=\"form-actions\"><button class=\"secondary-action\" type=\"button\" data-action=\"navegar.auth.cadastro.contato\">Voltar</button><button class=\"button\" type=\"submit\" data-action=\"navegar.auth.cadastro.seguranca\">Continuar</button></div><p class=\"form-status\" aria-live=\"polite\"></p></form></div></div></div></div></div>",
  "css": "/* Cabeçalho: sem estilos exclusivos; utiliza a folha do componente principal. */\n\n/* auth.cadastro.endereco · Cadastro · Dados pessoais · Endereço */\n\n/* arquivo local da tela; mantenha aqui apenas ajustes específicos deste HTML isolado */\n"
