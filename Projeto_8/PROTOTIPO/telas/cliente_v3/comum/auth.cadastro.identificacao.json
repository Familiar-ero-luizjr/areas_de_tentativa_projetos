  "titulo": "Cadastro · Dados pessoais · Identificação",
  "origem": "catalogo/telas/comum/auth/identificacao.json",
  "status": "original",
  "html": "<div class=\"screen-runtime\"><div class=\"prototype-screen\"><div class=\"screen-slot screen-slot--header\" data-slot=\"header\"><header class=\"topbar\"><img src=\"data:image/svg+xml;base64,\" alt=\"\"><span>AdvogadoJá</span></header></div><div class=\"screen-layout\"><div class=\"screen-slot screen-slot--main\" data-slot=\"main\"><div class=\"registration__shell\"><div class=\"registration__intro\"><p class=\"eyebrow\">Dados pessoais</p><h1>Identificação</h1><p>Este bloco é comum para Cliente e Advogado.</p></div><div class=\"progress\" aria-label=\"Etapa 2 de 7\"><span></span></div><form class=\"form-card\" data-registration-form=\"\"><div class=\"field\"><input id=\"reg-name\" name=\"name\" type=\"text\" placeholder=\" \" autocomplete=\"given-name\" data-reg-field=\"name\" required><label for=\"reg-name\">Nome</label></div><div class=\"field\"><input id=\"reg-surname\" name=\"surname\" type=\"text\" placeholder=\" \" autocomplete=\"family-name\" data-reg-field=\"surname\" required><label for=\"reg-surname\">Sobrenome</label></div><div class=\"field\"><input id=\"reg-username\" name=\"username\" type=\"text\" placeholder=\" \" autocomplete=\"username\" data-reg-field=\"username\" required><label for=\"reg-username\">Nome de usuário</label></div><div class=\"field\"><input id=\"reg-cpf\" name=\"cpf\" type=\"text\" placeholder=\" \" autocomplete=\"off\" data-reg-field=\"cpf\" required><label for=\"reg-cpf\">CPF</label></div><div class=\"field\"><input id=\"reg-birthday\" name=\"birthday\" type=\"date\" placeholder=\" \" autocomplete=\"bday\" data-reg-field=\"birthday\" required><label for=\"reg-birthday\">Data de nascimento</label></div><div class=\"select-field\"><label for=\"reg-gender\">Gênero</label><select id=\"reg-gender\" name=\"gender\" data-reg-field=\"gender\" required><option value=\"\">Selecionar</option><option value=\"feminino\">Feminino</option><option value=\"masculino\">Masculino</option><option value=\"nao-informar\">Prefiro não informar</option></select></div><label class=\"upload-field\"><span><strong>Foto de perfil</strong><small>Opcional · JPG ou PNG</small></span><span class=\"upload-button\">Escolher foto</span><input id=\"reg-photo\" type=\"file\" data-reg-file=\"profilePhoto\"><em data-file-name=\"\">Nenhum arquivo selecionado</em></label><div class=\"form-actions\"><button class=\"secondary-action\" type=\"button\" data-action=\"navegar.auth.cadastro.tipo_conta\">Voltar</button><button class=\"button\" type=\"submit\" data-action=\"navegar.auth.cadastro.contato\">Continuar</button></div><p class=\"form-status\" aria-live=\"polite\"></p></form></div></div></div></div></div>",
  "css": "/* Cabeçalho: sem estilos exclusivos; utiliza a folha do componente principal. */\n\n/* auth.cadastro.identificacao · Cadastro · Dados pessoais · Identificação */\n\n/* arquivo local da tela; mantenha aqui apenas ajustes específicos deste HTML isolado */\n"
