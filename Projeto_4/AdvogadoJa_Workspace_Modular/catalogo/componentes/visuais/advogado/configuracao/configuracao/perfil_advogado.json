  "estilos": {
    "css": ".settings-shell {\n  width:min(100%,720px);\n  margin:0 auto;\n  padding:28px 16px 40px;\n}\n\n.settings-heading {\n  margin:0 2px 16px;\n}\n\n.settings-eyebrow {\n  display:block;\n  margin-bottom:6px;\n  color:var(--gold);\n  font-size:10px;\n  font-weight:900;\n  letter-spacing:.08em;\n  text-transform:uppercase;\n}\n\n.settings-heading h1 {\n  margin:0;\n  color:var(--primary);\n  font-size:24px;\n  letter-spacing:-.025em;\n}\n\n.settings-heading p {\n  margin:6px 0 0;\n  color:var(--muted);\n  font-size:12px;\n  line-height:1.5;\n}\n\n.settings-grid {\n  display:grid;\n  gap:9px;\n}\n\n.settings-card {\n  width:100%;\n  display:grid;\n  grid-template-columns:42px minmax(0,1fr) auto;\n  align-items:center;\n  gap:11px;\n  padding:12px;\n  border:1px solid var(--line);\n  border-radius:14px;\n  background:#fff;\n  color:var(--text);\n  text-align:left;\n  box-shadow:0 3px 10px rgba(16,35,63,.035);\n  cursor:pointer;\n}\n\n.settings-card:hover {\n  border-color:#b8c6d8;\n}\n\n.settings-icon {\n  width:40px;\n  height:40px;\n  display:grid;\n  place-items:center;\n  border-radius:11px;\n  background:#eef3f8;\n  color:var(--primary);\n  font-size:14px;\n  font-weight:900;\n}\n\n.settings-copy {\n  min-width:0;\n}\n\n.settings-copy strong,\n.settings-copy small {\n  display:block;\n}\n\n.settings-copy strong {\n  color:var(--primary);\n  font-size:13px;\n}\n\n.settings-copy small {\n  margin-top:3px;\n  color:var(--muted);\n  font-size:10px;\n  line-height:1.4;\n}\n\n.settings-chevron {\n  color:var(--gold);\n  font-size:25px;\n  font-weight:900;\n  line-height:1;\n}\n\n.op-toast {\n  position:fixed;\n  left:50%;\n  bottom:18px;\n  z-index:100;\n  display:none;\n  max-width:min(92vw,460px);\n  padding:9px 13px;\n  transform:translateX(-50%);\n  border-radius:10px;\n  background:#172033;\n  color:#fff;\n  font-size:11px;\n  box-shadow:0 10px 30px rgba(0,0,0,.25);\n}\n\n.op-toast.show {\n  display:block;\n}\n\n@media(max-width:520px) {\n  .settings-shell {\n    padding-left:13px;\n    padding-right:13px;\n  }\n}\n",
    "id": "css_cmp.advogado.configuracao.configuracao.perfil_advogado.v01"
  },
