  "estilos": {
    "css": ".appointments-shell {\n  width: 100%;\n  display: grid;\n  gap: 16px;\n}\n\n.appointments-head {\n  padding: 2px 2px 0;\n}\n\n.appointments-eyebrow {\n  display: block;\n  margin-bottom: 6px;\n  color: var(--gold);\n  font-size: 11px;\n  font-weight: 900;\n  letter-spacing: .08em;\n  text-transform: uppercase;\n}\n\n.appointments-head h1 {\n  margin: 0;\n  color: var(--primary);\n  font-size: 24px;\n  line-height: 1.15;\n  letter-spacing: -.025em;\n}\n\n.appointments-head p {\n  max-width: 580px;\n  margin: 8px 0 0;\n  color: var(--muted);\n  font-size: 14px;\n  line-height: 1.5;\n}\n\n.appointments-tabs {\n  display: grid;\n  grid-template-columns: repeat(3, minmax(0,1fr));\n  gap: 6px;\n  padding: 5px;\n  border: 1px solid var(--line);\n  border-radius: 14px;\n  background: #f8fafc;\n}\n\n.appointments-tabs button {\n  min-width: 0;\n  min-height: 44px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 7px;\n  border: 0;\n  border-radius: 10px;\n  background: transparent;\n  color: #667085;\n  font-size: 12px;\n  font-weight: 800;\n  cursor: pointer;\n}\n\n.appointments-tabs button b {\n  min-width: 20px;\n  height: 20px;\n  padding: 0 5px;\n  display: grid;\n  place-items: center;\n  border-radius: 999px;\n  background: #e9eef5;\n  color: #475467;\n  font-size: 10px;\n}\n\n.appointments-tabs button.is-active {\n  background: #fff;\n  color: var(--primary);\n  box-shadow: 0 1px 4px rgba(16,35,63,.10);\n}\n\n.appointments-tabs button.is-active b {\n  background: #fff5dd;\n  color: #875b09;\n}\n\n.appointments-panels > section[hidden] {\n  display: none !important;\n}\n\n.appointments-section-head {\n  margin-bottom: 10px;\n}\n\n.appointments-section-head h2 {\n  margin: 0;\n  color: var(--primary);\n  font-size: 17px;\n}\n\n.appointments-section-head p {\n  margin: 4px 0 0;\n  color: var(--muted);\n  font-size: 12px;\n}\n\n.appointments-list {\n  display: grid;\n  gap: 10px;\n}\n\n.appointment-card {\n  width: 100%;\n  display: grid;\n  grid-template-columns: minmax(0,1fr) auto;\n  gap: 12px;\n  align-items: center;\n  padding: 15px;\n  border: 1px solid var(--line);\n  border-radius: 16px;\n  background: #fff;\n  color: var(--text);\n  text-align: left;\n  cursor: pointer;\n  box-shadow: 0 2px 7px rgba(16,35,63,.035);\n}\n\n.appointment-card:hover {\n  border-color: #b9c7d9;\n}\n\n.appointment-main {\n  min-width: 0;\n}\n\n.appointment-topline {\n  display: flex;\n  justify-content: space-between;\n  gap: 10px;\n  align-items: center;\n}\n\n.appointment-topline time {\n  color: var(--muted);\n  font-size: 10px;\n}\n\n.status {\n  display: inline-flex;\n  min-height: 23px;\n  align-items: center;\n  padding: 3px 8px;\n  border-radius: 999px;\n  font-size: 9px;\n  font-weight: 900;\n  letter-spacing: .035em;\n  text-transform: uppercase;\n}\n\n.status-requested {\n  background: #fff6df;\n  color: #855b0b;\n}\n\n.status-ongoing {\n  background: #ecfdf3;\n  color: #087443;\n}\n\n.status-closed {\n  background: #f2f4f7;\n  color: #475467;\n}\n\n.appointment-card h3 {\n  margin: 11px 0 0;\n  color: var(--primary);\n  font-size: 16px;\n}\n\n.appointment-card strong {\n  display: block;\n  margin-top: 4px;\n  color: #344054;\n  font-size: 12px;\n}\n\n.appointment-card p {\n  margin: 5px 0 0;\n  color: var(--muted);\n  font-size: 11px;\n  line-height: 1.45;\n}\n\n.appointment-chevron {\n  color: var(--gold);\n  font-size: 26px;\n  line-height: 1;\n}\n\n@media (max-width: 520px) {\n  .appointments-tabs {\n    grid-template-columns: 1fr;\n  }\n\n  .appointments-tabs button {\n    justify-content: space-between;\n    padding: 0 12px;\n  }\n}\n\n@media (min-width: 720px) {\n  .appointments-list {\n    grid-template-columns: 1fr 1fr;\n  }\n}\n",
    "id": "css_cmp.advogado.atendimentos_advogado.j1_advogado.v01"
  },
