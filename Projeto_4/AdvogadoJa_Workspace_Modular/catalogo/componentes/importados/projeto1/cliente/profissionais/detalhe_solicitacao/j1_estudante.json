  "estilos": {
    "css": "/* Cabeçalho: sem estilos exclusivos; utiliza a folha do componente principal. */\n.app-notification-button{position:relative;width:40px;height:40px;display:grid;place-items:center;padding:0;border:0;border-radius:10px;background:transparent;color:#fff;cursor:pointer}.app-notification-button:hover{background:rgba(255,255,255,.09)}.app-notification-button svg{width:22px;height:22px}.app-notification-badge{position:absolute;right:2px;top:2px;min-width:17px;height:17px;display:grid;place-items:center;padding:0 4px;border:2px solid var(--primary);border-radius:999px;background:#d92d20;color:#fff;font-size:9px;font-weight:900;line-height:1}\n\n/* Barra de título: sem estilos exclusivos; utiliza a folha do componente principal. */\n\n/* solicitacoes.cliente.detalhe_solicitacao · Cliente · Solicitação · Detalhe */\n\n/* arquivo local da tela; mantenha aqui apenas ajustes específicos deste HTML isolado */\n\n.prototype-drawer {\n  position: fixed;\n  z-index: 40;\n  inset: 0;\n  display: none;\n}\n\n.prototype-drawer.open { display: block; }\n\n.drawer-backdrop {\n  position: absolute;\n  inset: 0;\n  width: 100%;\n  border: 0;\n  background: rgba(7, 16, 30, .60);\n}\n\n.drawer-panel {\n  position: absolute;\n  inset: 0 auto 0 0;\n  width: min(80vw, 360px);\n  overflow: hidden;\n  display: flex;\n  flex-direction: column;\n  background: #3b4a7d;\n  color: #fff;\n  box-shadow: 12px 0 30px rgba(0, 0, 0, .32);\n}\n\n.drawer-top {\n  flex: 0 0 auto;\n  min-height: 106px;\n  padding: 30px 22px 20px;\n  display: flex;\n  align-items: center;\n}\n\n.drawer-identity {\n  min-width: 0;\n  display: flex;\n  gap: 14px;\n  align-items: center;\n}\n\n.drawer-avatar {\n  flex: 0 0 56px;\n  width: 56px;\n  height: 56px;\n  display: grid;\n  place-items: center;\n  border: 2px solid rgba(255, 255, 255, .20);\n  border-radius: 50%;\n  background: #dbeafe;\n  color: #1e3a8a;\n  font-size: 20px;\n  font-weight: 800;\n}\n\n.drawer-profile { min-width: 0; }\n.drawer-profile strong,\n.drawer-profile small { display: block; }\n.drawer-profile strong {\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n  font-size: 16px;\n  font-weight: 600;\n}\n.drawer-profile small {\n  margin-top: 2px;\n  color: #bfdbfe;\n  font-size: 11px;\n  font-weight: 400;\n  text-transform: lowercase;\n}\n\n.drawer-online {\n  flex: 0 0 auto;\n  width: calc(100% - 44px);\n  margin: 0 22px 10px;\n  display: grid;\n  grid-template-columns: auto 1fr auto;\n  gap: 10px;\n  align-items: center;\n  border: 1px solid rgba(255, 255, 255, .18);\n  border-radius: 10px;\n  padding: 10px 12px;\n  background: rgba(255, 255, 255, .08);\n  color: #fff;\n  text-align: left;\n  cursor: pointer;\n}\n.drawer-online-copy strong,\n.drawer-online-copy small { display: block; }\n.drawer-online-copy strong { font-size: 13px; }\n.drawer-online-copy small { margin-top: 2px; color: #bfdbfe; font-size: 10px; }\n.online-dot {\n  width: 9px;\n  height: 9px;\n  border-radius: 50%;\n  background: #4ade80;\n  box-shadow: 0 0 0 4px rgba(74, 222, 128, .14);\n}\n.drawer-online.is-offline .online-dot { background: #98a2b3; box-shadow: none; }\n.online-switch { position: relative; width: 38px; height: 22px; border-radius: 999px; background: #22c55e; }\n.online-switch b { position: absolute; top: 3px; right: 3px; width: 16px; height: 16px; border-radius: 50%; background: #fff; }\n.drawer-online.is-offline .online-switch { background: #64748b; }\n.drawer-online.is-offline .online-switch b { right: 19px; }\n\n.drawer-nav {\n  flex: 1 1 auto;\n  min-height: 0;\n  display: block;\n  margin: 0;\n  padding: 0 0 8px;\n  overflow-x: hidden;\n  overflow-y: auto;\n  overscroll-behavior: contain;\n  -webkit-overflow-scrolling: touch;\n  scrollbar-width: thin;\n  scrollbar-color: rgba(255, 255, 255, .35) transparent;\n}\n.drawer-nav::-webkit-scrollbar { width: 5px; }\n.drawer-nav::-webkit-scrollbar-thumb { border-radius: 999px; background: rgba(255, 255, 255, .35); }\n\n.drawer-nav button {\n  width: 100%;\n  min-height: 51px;\n  padding: 14px 22px;\n  border: 0;\n  border-bottom: 1px solid rgba(255, 255, 255, .10);\n  background: transparent;\n  color: #f8fafc;\n  display: flex;\n  gap: 15px;\n  align-items: center;\n  text-align: left;\n  font-size: 14px;\n  font-weight: 400;\n  cursor: pointer;\n}\n.drawer-nav button:hover { background: rgba(255, 255, 255, .08); }\n.drawer-icon { flex: 0 0 20px; width: 20px; height: 20px; color: #aebee5; }\n\n.drawer-footer {\n  flex: 0 0 auto;\n  margin-top: 0;\n  padding: 16px 22px 30px;\n  display: flex;\n  flex-direction: column;\n  gap: 22px;\n  background: rgba(0, 0, 0, .10);\n}\n.drawer-footer-top { display: flex; justify-content: space-between; gap: 12px; align-items: center; }\n.drawer-logout {\n  min-height: 32px;\n  padding: 0;\n  border: 0;\n  background: transparent;\n  color: #f8fafc;\n  display: flex;\n  gap: 10px;\n  align-items: center;\n  font-size: 14px;\n  cursor: pointer;\n}\n.drawer-logout svg { width: 18px; height: 18px; color: #aebee5; }\n.drawer-footer small { color: #aebee5; font-size: 10px; }\n.drawer-emergency {\n  min-height: 41px;\n  border: 1px solid rgba(255, 255, 255, .54);\n  border-radius: 999px;\n  background: transparent;\n  color: #fff;\n  font-size: 14px;\n  font-weight: 600;\n  cursor: pointer;\n}\n.drawer-emergency:hover { background: rgba(255, 255, 255, .08); }\n\n@media (max-width: 420px) {\n  .drawer-panel { width: 80vw; }\n  .drawer-top { padding-top: 24px; }\n}\n",
