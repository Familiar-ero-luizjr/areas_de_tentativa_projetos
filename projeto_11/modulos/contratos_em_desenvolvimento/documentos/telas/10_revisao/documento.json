                "declaracoes": "margin: 2px 2px 18px;"
              },
              {
                "id": 9,
                "seletor": ".registration__intro h1,\n.registration--success h1",
                "declaracoes": "margin: 0;\n  color: var(--primary);\n  font-size: clamp(25px, 7vw, 34px);\n  line-height: 1.12;\n  letter-spacing: -0.025em;"
              },
