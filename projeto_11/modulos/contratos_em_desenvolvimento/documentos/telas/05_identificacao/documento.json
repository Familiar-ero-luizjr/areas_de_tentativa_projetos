                "declaracoes": "min-width: 320px;\n  min-height: 100dvh;\n  margin: 0;\n  background: var(--page);\n  color: var(--text);"
              },
              {
                "id": 3,
                "seletor": "button,\ninput",
                "declaracoes": "font: inherit;"
              },
