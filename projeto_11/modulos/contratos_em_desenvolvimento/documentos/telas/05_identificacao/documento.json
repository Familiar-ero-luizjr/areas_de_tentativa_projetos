              },
              {
                "id": 5,
                "seletor": ".button",
                "declaracoes": "display: grid;\n  width: 100%;\n  min-height: 54px;\n  place-items: center;\n  border: 0;\n  border-radius: 13px;\n  padding: 14px 18px;\n  background: var(--primary);\n  color: #fff;\n  font-size: 14px;\n  font-weight: 800;\n  cursor: pointer;"
              },
              {
                "id": 6,
                "seletor": ".field",
                "declaracoes": "position: relative;\n  margin-bottom: 14px;"
              },
              {
                "id": 7,
                "seletor": ".field input",
                "declaracoes": "width: 100%;\n  min-height: 57px;\n  border: 1px solid var(--line);\n  border-radius: 12px;\n  padding: 22px 14px 9px;\n  outline: 0;"
              },
              {
                "id": 8,
                "seletor": ".field label",
                "declaracoes": "position: absolute;\n  top: 8px;\n  left: 14px;\n  color: var(--primary);\n  font-size: 10px;\n  font-weight: 800;"
              },
              {
                "id": 9,
                "seletor": ".registration",
                "declaracoes": "min-height: 100dvh;\n  background: var(--page);"
              },
              {
                "id": 10,
                "seletor": ".registration__shell",
                "declaracoes": "width: min(100%, 620px);\n  margin: 0 auto;\n  padding: 24px 18px 48px;"
              },
              {
                "id": 11,
                "seletor": ".registration__intro",
                "declaracoes": "margin: 2px 2px 18px;"
              },
              {
                "id": 12,
                "seletor": ".registration__intro h1,\n.registration--success h1",
                "declaracoes": "margin: 0;\n  color: var(--primary);\n  font-size: clamp(25px, 7vw, 34px);\n  line-height: 1.12;\n  letter-spacing: -0.025em;"
              },
              {
                "id": 13,
                "seletor": ".registration__intro > p:not(.eyebrow),\n.registration--success > .registration__shell > p:not(.eyebrow):not(.form-status)",
                "declaracoes": "margin: 10px 0 0;\n  color: var(--muted);\n  font-size: 14px;\n  line-height: 1.58;"
              },
              {
                "id": 14,
                "seletor": ".progress",
                "declaracoes": "height: 5px;\n  margin: 0 2px 18px;\n  overflow: hidden;\n  border-radius: 999px;\n  background: #dce4ed;"
              },
              {
                "id": 15,
                "seletor": ".progress span",
                "declaracoes": "display: block;\n  height: 100%;\n  border-radius: inherit;\n  background: var(--gold);"
              },
              {
                "id": 16,
                "seletor": ".form-card",
                "declaracoes": "padding: 18px;\n  border: 1px solid var(--line);\n  border-radius: 18px;\n  background: var(--surface);"
              },
              {
                "id": 17,
                "seletor": ".form-card .field:last-of-type",
                "declaracoes": "margin-bottom: 0;"
              },
              {
                "id": 18,
                "seletor": ".form-card .field input,\n.form-card .select-field select",
                "declaracoes": "background: #fff;\n  color: var(--text);"
              },
              {
                "id": 19,
                "seletor": ".select-field",
                "declaracoes": "position: relative;\n  margin-bottom: 14px;"
              },
              {
                "id": 20,
                "seletor": ".select-field label",
                "declaracoes": "position: absolute;\n  z-index: 1;\n  top: 8px;\n  left: 14px;\n  color: var(--primary);\n  font-size: 10px;\n  font-weight: 800;\n  pointer-events: none;"
              },
              {
                "id": 21,
                "seletor": ".select-field select",
                "declaracoes": "width: 100%;\n  min-height: 57px;\n  appearance: auto;\n  border: 1px solid var(--line);\n  border-radius: 12px;\n  padding: 22px 40px 9px 14px;\n  outline: 0;\n  cursor: pointer;"
              },
              {
                "id": 22,
                "seletor": ".form-actions",
                "declaracoes": "display: grid;\n  grid-template-columns: minmax(96px, .7fr) 1.3fr;\n  gap: 10px;\n  margin-top: 20px;"
              },
              {
                "id": 23,
                "seletor": ".secondary-action",
                "declaracoes": "min-height: 54px;\n  border: 1px solid var(--line);\n  border-radius: 13px;\n  padding: 14px 16px;\n  background: #fff;\n  color: var(--primary);\n  font-weight: 800;\n  cursor: pointer;"
              },
              {
                "id": 24,
                "seletor": ".form-status",
                "declaracoes": "min-height: 18px;\n  margin: 10px 0 0;\n  color: #9b2c2c;\n  text-align: center;\n  font-size: 11px;\n  font-weight: 700;"
              },
              {
                "id": 25,
                "seletor": ".upload-field",
                "declaracoes": "position: relative;\n  display: grid;\n  grid-template-columns: 1fr auto;\n  gap: 8px 12px;\n  align-items: center;\n  margin: 4px 0 14px;\n  border: 1px solid var(--line);\n  border-radius: 12px;\n  padding: 13px 14px;\n  cursor: pointer;"
              },
              {
                "id": 26,
                "seletor": ".upload-field input",
                "declaracoes": "position: absolute;\n  width: 1px;\n  height: 1px;\n  opacity: 0;\n  pointer-events: none;"
              },
              {
                "id": 27,
